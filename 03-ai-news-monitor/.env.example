# .env 模板文件
# 复制此文件为 .env，然后填入你的实际 API 密钥

# ============ DeepSeek API ============
# 获取方式：https://platform.deepseek.com/（API Keys 页面）
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ============ Telegram Bot（推荐） ============
# 获取 TOKEN：向 @BotFather 发送 /newbot
# 获取 CHAT_ID：向 @userinfobot 转发任意消息
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ============ PushDeer（备选，国内友好） ============
# 获取 PUSHKEY：在 https://www.pushdeer.com/ 注册并获取
PUSHDEER_PUSHKEY=your_pushdeer_pushkey_here

# ============ 轮询配置 ============
# 轮询间隔，单位秒（建议 60-300，避免频繁请求）
POLL_INTERVAL=60

# 推送渠道：'telegram' 或 'pushdeer'
PUSH_CHANNEL=telegram
